{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "plaka-tahmini.vercel.app" }],
      "destination": "https://plakatahmini.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.plakatahmini.com" }],
      "destination": "https://plakatahmini.com/$1",
      "permanent": true
    }
  ]
}
